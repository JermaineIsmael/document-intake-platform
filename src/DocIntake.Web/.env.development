# Local development defaults (`npm run dev`). Override per machine in .env.development.local (git-ignored).
#
# The API's appsettings.Development.json enables Development:BypassAuth, so sign-in is disabled here
# and requests are proxied to http://localhost:5067 under /api (see vite.config.ts).
VITE_API_BASE_URL=/api
VITE_AUTH_ENABLED=false
VITE_MAX_UPLOAD_MB=25
