# Copy to .env.development.local (local) or set as environment variables before `npm run build`.
# Values are embedded in the static bundle at build time; never put secrets here.

# API root. Local dev: /api (Vite proxy). Deployed: https://<api-container-app-fqdn>
VITE_API_BASE_URL=/api

# Set to false only with an API that runs Development:BypassAuth=true in the Development environment.
VITE_AUTH_ENABLED=true

# Entra ID: the existing API app registration (its client ID is also the API audience),
# with a "Single-page application" platform and this site's origin as a redirect URI.
VITE_AUTH_CLIENT_ID=<api-client-id>
VITE_AUTH_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# Optional; defaults to api://<VITE_AUTH_CLIENT_ID>/access_as_user
VITE_API_SCOPE=api://<api-client-id>/access_as_user

# Must match the API's Upload:MaxFileSizeMb (the API still enforces it).
VITE_MAX_UPLOAD_MB=25

# Dev server only: where /api is proxied (defaults to http://localhost:5067).
API_PROXY_TARGET=http://localhost:5067
